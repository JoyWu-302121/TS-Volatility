import pandas as pd
import numpy as np
from scipy.stats import norm

# ── 1. LOAD SHEETS ─────────────────────────────────────────────────────────────
delta_df = pd.read_excel('options_data_2025.xlsx', sheet_name='Delta_Trading')
iv_df    = pd.read_excel('options_data_2025.xlsx', sheet_name='IV')

delta_df['Date'] = pd.to_datetime(delta_df['Date'])
iv_df['Date']    = pd.to_datetime(iv_df['Date'])

# ── 2. MERGE SHEETS ────────────────────────────────────────────────────────────
bs_df = pd.merge(
    delta_df,
    iv_df[['Date', 'IV_30D_Call(%)', 'IV_30D_Put(%)']],
    on='Date',
    how='inner'
)

print(f"✓ Merged rows : {len(bs_df)}")

# ── 3. BLACK-SCHOLES DELTA FUNCTION ───────────────────────────────────────────
def calculate_bs_deltas(row):
    S          = row['Underlying (SPX Spot)']
    K          = row['ATM Strike']
    r          = row['RF_1M/100']
    T          = row['DTE_F = FrontExp - Date'] / 365
    sigma_call = row['IV_30D_Call(%)'] / 100
    sigma_put  = row['IV_30D_Put(%)']  / 100

    d1_call    = (np.log(S / K) + (r + 0.5 * sigma_call ** 2) * T) / (sigma_call * np.sqrt(T))
    delta_call = norm.cdf(d1_call)

    d1_put     = (np.log(S / K) + (r + 0.5 * sigma_put ** 2) * T) / (sigma_put * np.sqrt(T))
    delta_put  = norm.cdf(d1_put) - 1

    straddle_delta = delta_call + delta_put
    return pd.Series([delta_call, delta_put, straddle_delta])

# ── 4. APPLY BLACK-SCHOLES ────────────────────────────────────────────────────
bs_df[['Call_Delta', 'Put_Delta', 'Straddle_Delta']] = bs_df.apply(calculate_bs_deltas, axis=1)

# ── 5. COMPARE WITH EXCEL DELTAS ──────────────────────────────────────────────
bs_df['Call_Delta_Diff']     = bs_df['Call_Delta']     - bs_df['Call Delta（Trading）']
bs_df['Put_Delta_Diff']      = bs_df['Put_Delta']      - bs_df['Put Delta (Trading)']
bs_df['Straddle_Delta_Diff'] = bs_df['Straddle_Delta'] - bs_df['Straddle Delta']

# ── 6. PRINT RESULTS ──────────────────────────────────────────────────────────
print("\n── BLACK-SCHOLES DELTA RESULTS ──")
cols = ['Date', 'RF_1M/100', 'Call_Delta', 'Put_Delta', 'Straddle_Delta']
print(bs_df[cols].head(10).to_string(index=False))

print("\n── VERIFICATION vs EXCEL ──")
verify_cols = ['Date', 'Call Delta（Trading）', 'Call_Delta', 'Call_Delta_Diff',
                       'Put Delta (Trading)',   'Put_Delta',  'Put_Delta_Diff']
print(bs_df[verify_cols].head(10).to_string(index=False))

print("\n── RISK FREE RATE USED (Per Row) ──")
print(bs_df[['Date', 'RF_1M/100']].describe())


