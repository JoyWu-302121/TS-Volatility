def get_ewma_forecast(df: pd.DataFrame, col_name: str, span: int = 30) -> pd.Series:
    """
    Calculates annualized EWMA volatility forecast.

    Parameters:
        df       : DataFrame containing the return column
        col_name : Column name of log returns
        span     : EWMA span (controls lambda decay). Default = 30
                   Lambda = 1 - (2 / (span + 1))

    Returns:
